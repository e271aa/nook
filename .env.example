# Copia para .env e muda a password antes de expor a demo.
# Esta conta é a de administrador (acesso completo ao Home Assistant).
# Só entra a partir da rede local.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=muda-esta-password
ADMIN_NAME=Administrador

# Onde a demo fica acessível (http://localhost:8123). Por omissão só na própria
# máquina; DEMO_BIND=0.0.0.0 abre-a à rede local.
DEMO_PORT=8123
DEMO_BIND=127.0.0.1
TZ=Europe/Lisbon

# Num cartão SD: base de dados do histórico em memória, para não gastar o cartão.
# Perde-se quando o contentor reinicia; a casa simulada refaz a energia no arranque.
# RECORDER_DB_URL=sqlite:////ram/home-assistant_v2.db
